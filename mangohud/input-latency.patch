+// ember: input latency row. Value comes from VK_LAYER_EMBER_latency, which writes
+// /dev/shm/ember-latency/<pid> (line 1 = avg of the last 16 presses in ms).
+// Drawn like the fps_metrics rows; the file is re-read at most 4x a second.
+void HudElements::input_latency(){
+    static char value[16] = "-";
+    static std::chrono::steady_clock::time_point next_read;
+    auto now = std::chrono::steady_clock::now();
+    if (now >= next_read) {
+        next_read = now + std::chrono::milliseconds(250);
+        char path[64];
+        snprintf(path, sizeof(path), "/dev/shm/ember-latency/%d", (int)getpid());
+        char line[16] = "";
+        if (FILE *f = fopen(path, "re")) {
+            if (!fgets(line, sizeof(line), f))
+                line[0] = 0;
+            fclose(f);
+        }
+        line[strcspn(line, "\r\n")] = 0;
+        snprintf(value, sizeof(value), "%s", line[0] ? line : "-");
+    }
+
+    if (!HUDElements.params->enabled[OVERLAY_PARAM_ENABLED_horizontal])
+        ImGui::TableNextRow();
+    ImguiNextColumnFirstItem();
+    HUDElements.TextColored(HUDElements.colors.engine, "%s", "INPUT");
+    ImguiNextColumnOrNewRow();
+    right_aligned_text(HUDElements.colors.text, HUDElements.ralign_width, "%s", value);
+    if (strcmp(value, "-") != 0) {
+        ImGui::SameLine(0, 1.0f);
+        ImGui::PushFont(HUDElements.sw_stats->font_small);
+        HUDElements.TextColored(HUDElements.colors.text, "ms");
+        ImGui::PopFont();
+    }
+    ImguiNextColumnOrNewRow();
+}
